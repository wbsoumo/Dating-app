# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop if already accessing public
    RewriteCond %{REQUEST_URI} !^/public/

    # Rewrite all requests to public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|deploy\.sh|\.git">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
